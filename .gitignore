# ── 파이썬 ──────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
# pip install -e 가 만드는 빌드 산출물
*.egg-info/
build/
dist/

# ── 환경변수 ────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 작업 노트 — 공개 대상 아님 (블로그 원재료) ──────────
#   디렉터리째 제외하면 하위 예외(!)가 안 먹으므로 /docs/* 로 쓴다
/docs/*
# 단, 실험 기록은 공개한다 — 코드의 상수들이 근거로 참조하는 문서다
!/docs/experiments/

# Claude 메모리 / 로컬 설정 — 공개 대상 아님
.claude/

# ── 데이터·산출물 ───────────────────────────────────────
# 이미지·데이터셋·호출 캐시는 저장소에 넣지 않는다
#   (디렉터리째 제외하면 하위 예외(!)가 안 먹으므로 /* 로 쓴다 — docs 와 같은 이유)
notebooks/data/*
!notebooks/data/.gitkeep
# 모델 호출 캐시 (Groq 가 4장/분이라 캐시는 필수인데 용량이 크다)
*.pkl
# 하루 누적 기록
*.sqlite3
*.db

# ── OS ──────────────────────────────────────────────────
.DS_Store
