# --- 모델 A: 상용 폐쇄 가중치 ---
#   무료 티어로 충분하다. 실측(2026-09-06): 영수증 1장 ≈ 470 토큰 · 1,500 요청/일
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 모델 B: 오픈소스 가중치 (교차검증용) ---
#   벤더와 계열이 달라야 "같은 실수를 하지 않는다"는 교차검증의 전제가 성립한다.
#   실측(2026-09-06): 영수증 1장 ≈ 1,873 토큰 · 8,000 토큰/분 → 약 4장/분 (병목)
#   https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- 서버 ---
APP_ENV=development
