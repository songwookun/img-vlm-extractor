GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- VLM (선택): 상용 폐쇄 가중치 ---
#   실측(2026-09-07): 무료 티어 하루 20 요청 — 소량 비교용
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
